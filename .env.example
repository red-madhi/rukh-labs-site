# Public HTTPS URL after deployment, no trailing slash.
APP_URL=https://your-iazma-guard-domain.example

# Neon Postgres connection string.
DATABASE_URL=postgresql://...

# A PKCS8/PEM P-256 private key used by the AT Protocol confidential OAuth client.
# Generate with: openssl genpkey -algorithm EC -pkeyopt ec_paramgen_curve:P-256
OAUTH_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# Random secrets (32+ bytes recommended).
SESSION_SECRET=replace-with-a-long-random-secret
CRON_SECRET=replace-with-a-long-random-secret
IAZMA_API_KEY=replace-with-a-long-random-secret
