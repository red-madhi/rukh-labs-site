{
  "manifest_version": 3,
  "name": "Job Cannon Autofill",
  "version": "0.1.0",
  "description": "User-triggered ATS autofill that leaves final review and submission to you.",
  "permissions": ["activeTab", "scripting", "storage", "unlimitedStorage"],
  "action": {
